# Copy to .env (git-ignored) and replace the placeholders. The harness reads these from the environment;
# a .env file in the repo root is loaded only for values the environment doesn't already set.
# Without a key the harness still runs: it uses its built-in readers and skips the Claude fallback.

# Your Anthropic API key. The grading container supplies its own.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# Optional: API endpoint. Leave empty for the default (https://api.anthropic.com).
ANTHROPIC_BASE_URL=

# Optional: model for document reading (fallback extraction and the scanned-invoice vision read).
NOVA_MODEL=claude-sonnet-5-5

# Optional: set to 0 to turn every Claude call off, even when a key is present.
NOVA_USE_LLM=1
